# --- Generated databases (never commit; rebuild from Datadump) ---
*.mdb
*.accdb
*.laccdb
*.sqlite
*.sqlite3
*.db

# --- Cached Datadump extractions ---
.datadump_cache/
*.tar.gz.extracted/
# Belt-and-braces: never commit raw Datadump archives even if copied here by accident
*.tar.gz
*.rar
*.7z

# --- Reports artefacts ---
# Per-query layout is reports/<query_id>/{access.json, avalonia.json,
# diff.json, summary.md, hypothesis.md}. The two raw-side dumps can be
# very large and are always regenerable from the source databases, so
# they are NOT committed. The canonical diff and the markdown narrative
# ARE committed — that is the deliverable trail of each parity run.
reports/**/access.json
reports/**/avalonia.json
reports/**/*.csv
reports/**/*.parquet

# build_manifest.json lives at repo root (data-version provenance) and is
# committed. Nothing above ignores it, so no negation needed; this comment
# exists to document the intent.

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
