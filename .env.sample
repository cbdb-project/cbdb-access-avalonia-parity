# =============================================================================
# cbdb-access-avalonia-parity — sample environment file
# =============================================================================
# Copy this file to `.env` and fill in the real paths on your machine.
# `.env` is gitignored; `.env.sample` is committed as the schema reference.
#
# Every key listed here is mandatory; the harness will refuse to start if
# any of them is missing.
# =============================================================================

# --- Datadump source --------------------------------------------------------
# Folder containing the `cbdb_data_YYYYMMDD.tar.gz` archives.
# The build pipeline auto-picks the newest archive in this folder.
DATADUMP_DIR=D:\path\to\Datadump

# --- Fixed Access "user" mdb (UI front-end) ---------------------------------
# Absolute path to the CBDB_BJ_User.mdb file. Paired with the generated
# `cbdb_data.mdb` to form a working Access stack.
CBDB_USER_MDB=C:\path\to\CBDB_BJ_User.mdb

# --- External git repos (cloned locally; refreshed on every parity run) -----
# All four are pulled with `git pull --ff-only` by
# `scripts/refresh_external_repos.py` before any harness entrypoint runs.

# https://github.com/cbdb-project/cbdb-user-mdb-tests
ACCESS_TESTS_REPO=C:\path\to\cbdb-user-mdb-tests

# https://github.com/frankslin/cbdb-desktop-app
AVALONIA_REPO=C:\path\to\cbdb-desktop-app

# https://github.com/cbdb-project/cbdb-online-main-server
ONLINE_SERVER_REPO=C:\path\to\cbdb-online-main-server

# https://github.com/cbdb-project/accessAndMySQLTransfer
ACCESS_MYSQL_TRANSFER_REPO=C:\path\to\accessAndMySQLTransfer

# --- External non-git folder (skipped by the refresher) ---------------------
# Local working folder with Datadump → Access conversion spreadsheets.
# This is NOT a git repo; the refresher leaves it untouched.
MYSQL2ACCESS_DIR=C:\path\to\mysql2access

# --- Local scratch / build output (gitignored) ------------------------------
# Folder for the generated `cbdb_data.mdb` and `cbdb.sqlite`. The build
# pipeline writes here; the harness reads from here. Caching keys by
# Datadump SHA live under this directory.
BUILD_OUTPUT_DIR=.build

# --- MariaDB intermediate cache (Phase 1.6, see WORK_PLAN §4d) --------------
# Datadump → MariaDB → (sqlite, mdb). MariaDB sits between the Datadump
# tar.gz and the two builders, accelerating both legs vs the Python-only
# import path.
#
# The MariaDB cache is OPTIONAL: leave all five required keys BLANK to
# disable it (the builders then fall back to source='datadump'). To
# enable it, set all five — `cbdb_parity.config` refuses to load a
# partially-configured cache to catch typos. We ship blank values in
# the sample on purpose so a copied-but-not-customised `.env` cannot
# accidentally have the importer connect to a real local MariaDB and
# `DROP DATABASE` it. Fill these in only on hosts that genuinely run
# the MariaDB cache container.
MARIADB_HOST=
MARIADB_PORT=
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=

# Optional knobs (used only when the five required keys above are set):
# - MARIADB_CONTAINER_NAME: informational; used only when MARIADB_AUTO_LAUNCH=1.
# - MARIADB_FORCE_REIMPORT=1: drop+recreate the database and re-import
#   even when the in-DB provenance row says the current Datadump SHA is
#   already cached.
# - MARIADB_AUTO_LAUNCH=1: if the named container is stopped, run
#   `docker start <MARIADB_CONTAINER_NAME>` and wait for it. Default 0
#   requires the user to bring the container up themselves.
MARIADB_CONTAINER_NAME=cbdb-parity-mariadb
MARIADB_FORCE_REIMPORT=0
MARIADB_AUTO_LAUNCH=0

# --- Top-tier build cache switch --------------------------------------------
# Controls whether `cbdb-parity-build-all` short-circuits when the
# previous run's products are still in BUILD_OUTPUT_DIR and the
# manifest is internally consistent.
#
# CBDB_PARITY_USE_CACHE=1 (default):
#   - After the mandatory refresh of the four external repos, if both
#     `cbdb.sqlite` and `cbdb_data.mdb` exist in BUILD_OUTPUT_DIR and
#     `build_manifest.json` records them with paths that resolve to
#     those files, exit 0 immediately. NO Datadump scan, NO MariaDB
#     connect, NO builder runs.
#   - Trades freshness for time: a brand-new tar.gz dropped in
#     DATADUMP_DIR will be IGNORED until you flip this to 0, pass
#     `--rebuild`, delete one of the .build/ products, or set
#     MARIADB_FORCE_REIMPORT=1. This matches the 3-4-hour cost of an
#     mdb rebuild — you should explicitly opt in to regenerating.
#
# CBDB_PARITY_USE_CACHE=0:
#   - Always run the full pipeline. The MariaDB and manifest SHA caches
#     still hit when the Datadump is unchanged, so a same-SHA run still
#     finishes in seconds — you just pay the Datadump tar.gz hashing
#     and (if no cached row) the MariaDB SHA check.
#
# Interaction with the two finer-grained overrides:
#   - `cbdb-parity-build-all --rebuild` ALWAYS bypasses USE_CACHE for
#     that one invocation (and the manifest cache for that one run).
#   - `MARIADB_FORCE_REIMPORT=1` ALSO bypasses USE_CACHE for that run —
#     setting it means "I want the MariaDB layer re-imported from the
#     Datadump", which by definition makes the cached products built
#     from the old MariaDB stale.
#   - When the four refresh repos pull new commits, only an updated
#     ACCESS_MYSQL_TRANSFER_REPO invalidates USE_CACHE (it owns
#     TablesFields.xlsx, which the mdb CREATE TABLE derives from).
#     The other three repos affect Phase 3 tests but NOT the build
#     products themselves.
CBDB_PARITY_USE_CACHE=1
