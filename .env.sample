# =============================================================================
# cbdb-access-avalonia-parity — sample environment file
# =============================================================================
# Copy this file to `.env` and fill in the real paths on your machine.
# `.env` is gitignored; `.env.sample` is committed as the schema reference.
#
# Every key listed here is mandatory; the harness will refuse to start if
# any of them is missing.
# =============================================================================

# --- Datadump source --------------------------------------------------------
# Folder containing the `cbdb_data_YYYYMMDD.tar.gz` archives.
# The build pipeline auto-picks the newest archive in this folder.
DATADUMP_DIR=D:\path\to\Datadump

# --- Fixed Access "user" mdb (UI front-end) ---------------------------------
# Absolute path to the CBDB_BJ_User.mdb file. Paired with the generated
# `cbdb_data.mdb` to form a working Access stack.
CBDB_USER_MDB=C:\path\to\CBDB_BJ_User.mdb

# --- External git repos (cloned locally; refreshed on every parity run) -----
# All four are pulled with `git pull --ff-only` by
# `scripts/refresh_external_repos.py` before any harness entrypoint runs.

# https://github.com/cbdb-project/cbdb-user-mdb-tests
ACCESS_TESTS_REPO=C:\path\to\cbdb-user-mdb-tests

# https://github.com/frankslin/cbdb-desktop-app
AVALONIA_REPO=C:\path\to\cbdb-desktop-app

# https://github.com/cbdb-project/cbdb-online-main-server
ONLINE_SERVER_REPO=C:\path\to\cbdb-online-main-server

# https://github.com/cbdb-project/accessAndMySQLTransfer
ACCESS_MYSQL_TRANSFER_REPO=C:\path\to\accessAndMySQLTransfer

# --- External non-git folder (skipped by the refresher) ---------------------
# Local working folder with Datadump → Access conversion spreadsheets.
# This is NOT a git repo; the refresher leaves it untouched.
MYSQL2ACCESS_DIR=C:\path\to\mysql2access

# --- Local scratch / build output (gitignored) ------------------------------
# Folder for the generated `cbdb_data.mdb` and `cbdb.sqlite`. The build
# pipeline writes here; the harness reads from here. Caching keys by
# Datadump SHA live under this directory.
BUILD_OUTPUT_DIR=.build
